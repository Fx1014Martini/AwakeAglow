/* 对齐原型 app.css §Menu/filter：1px ≈ 1.923rpx */
.menu-page { padding-top:8rpx; }
.menu-search { margin-top:28rpx; min-height:96rpx; padding:0 29rpx; display:flex; align-items:center; gap:19rpx; border-radius:35rpx; box-shadow:0 8rpx 28rpx rgba(73,43,17,.055); }
.theme-cocktail .menu-search { box-shadow:0 12rpx 34rpx rgba(0,0,0,.22); }
.menu-search image { width:37rpx; height:37rpx; }
.menu-search input { flex:1; height:48rpx; line-height:48rpx; color:var(--xx-text); font-size:23rpx; }
.menu-search__placeholder { color:var(--xx-text2); }
.menu-search__clear { width:54rpx; height:54rpx; color:var(--xx-text2); font-size:30rpx; }
.menu-search__scan { color:var(--xx-primary); font-size:30rpx; }
.filter-panel { margin-top:23rpx; padding:27rpx; border-radius:35rpx; }
.filter-panel__head { min-height:60rpx; display:flex; align-items:center; justify-content:space-between; }
.filter-panel__title { display:flex; align-items:center; gap:11rpx; }
.filter-panel__title image { width:31rpx; height:31rpx; }
.filter-panel__title text { font-size:31rpx; color:var(--xx-text); }
.filter-panel__head>view:last-child { display:flex; align-items:center; gap:10rpx; }
.filter-panel__head>view:last-child view { min-height:54rpx; padding:0 7rpx; color:var(--xx-text2); font-size:19rpx; }
.filter-groups { margin-top:9rpx; }
.filter-group { min-height:76rpx; padding:15rpx 0; display:grid; grid-template-columns:138rpx 1fr; gap:13rpx; align-items:start; border-top:0; }
.filter-group__label { padding-top:15rpx; font-size:19rpx; font-weight:800; color:var(--xx-text); }
.filter-group__options { display:flex; flex-wrap:wrap; gap:12rpx; }
.tri-chip { min-height:54rpx; padding:0 17rpx; display:flex; align-items:center; gap:6rpx; border:1rpx solid var(--xx-border); border-radius:17rpx; color:var(--xx-text2); background:transparent; font-size:17rpx; }
.tri-chip:active { transform:scale(.97); }
.tri-state-WANT { color:var(--xx-primary); border-color:var(--xx-chip-wanted-border); background:var(--xx-chip-wanted); }
.tri-state-EXCLUDE { color:var(--xx-chip-excluded-text); border-color:var(--xx-chip-excluded-border); background:var(--xx-chip-excluded); text-decoration:line-through; }
.tri-mark { font-weight:800; }
.filter-summary { margin:19rpx -27rpx 0; min-height:67rpx; padding:14rpx 27rpx; display:flex; align-items:center; gap:7rpx; border-top:1rpx solid var(--xx-border); color:var(--xx-text2); font-size:17rpx; line-height:1.5; }
.filter-summary>text:nth-child(2) { flex:1; color:var(--xx-primary); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.filter-summary view { color:var(--xx-text2); font-size:17rpx; }
.result-head { margin:35rpx 4rpx 19rpx; display:flex; align-items:center; justify-content:space-between; color:var(--xx-text2); font-size:19rpx; }
.result-head .number { color:var(--xx-text); font-size:25rpx; }
.result-head__actions{display:flex;align-items:center;gap:12rpx}.result-head__sort{min-height:50rpx;padding:0 5rpx;color:var(--xx-text2);font-size:21rpx}.result-head__compare{min-height:50rpx;padding:0 15rpx;border-radius:13rpx;display:flex;align-items:center;justify-content:center;color:var(--xx-text2);border:1rpx solid var(--xx-border);font-size:21rpx}.result-head__compare.is-active{color:var(--xx-on-primary);background:var(--xx-primary);border-color:var(--xx-primary)}
.result-list { display:flex; flex-direction:column; gap:19rpx; }
.menu-skeleton { display:flex; flex-direction:column; gap:19rpx; }
.skeleton-card { height:216rpx; border-radius:28rpx; background:linear-gradient(100deg,var(--xx-surface-muted),var(--xx-surface-strong),var(--xx-surface-muted)); background-size:200% 100%; animation:xx-shimmer 1.35s linear infinite; }
.safety-banner { margin-top:18rpx; padding:16rpx 20rpx; border-radius:18rpx; border:1rpx solid rgba(212,167,91,.28); background:rgba(91,24,35,.25); color:var(--xx-primary); font-size:19rpx; text-align:center; }
.compare-bar { position:fixed; z-index:95; left:20rpx; right:20rpx; bottom:calc(130rpx + env(safe-area-inset-bottom) + 15rpx); min-height:100rpx; padding:14rpx 16rpx 14rpx 22rpx; display:flex; align-items:center; gap:14rpx; border-radius:28rpx; background:var(--xx-surface-strong); border:1rpx solid var(--xx-border); box-shadow:0 18rpx 48rpx rgba(0,0,0,.22); }
.compare-bar>view { min-width:0; flex:1; display:flex; flex-direction:column; }
.compare-bar>view text:first-child { color:var(--xx-primary); font-size:19rpx; }
.compare-bar>view text:last-child { margin-top:6rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; color:var(--xx-text2); font-size:18rpx; }
.compare-bar>view:last-child { min-width:180rpx; min-height:70rpx; display:flex; align-items:center; justify-content:center; }
@media(max-width:360px){.filter-group{grid-template-columns:123rpx 1fr}.filter-group__label{font-size:19rpx}.filter-panel{padding-left:23rpx;padding-right:23rpx}.filter-summary{margin-left:-23rpx;margin-right:-23rpx}}
