/* 鸡尾酒成年门禁页：cocktail 主题深莓底 + 居中声明卡。
   主题变量继承自 app.wxss 的 view[data-mode="cocktail"].page 覆盖。 */
.age-gate-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: var(--bg);
}

.age-card {
  width: 100%;
  max-width: 640rpx;
  background: var(--surface);
  border-radius: 24rpx;
  padding: 56rpx 40rpx;
  box-shadow: var(--shadow);
  text-align: center;
}

.age-mark {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto 32rpx;
  border-radius: 50%;
  background: var(--primary);
  color: var(--td-text-color-anti, #fff);
  font-size: 44rpx;
  font-weight: 700;
}

.age-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 24rpx;
}

.age-desc {
  font-size: 28rpx;
  color: var(--text);
  opacity: 0.8;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.age-warning {
  font-size: 24rpx;
  color: var(--td-error-color);
  margin-bottom: 48rpx;
  line-height: 1.5;
}

.age-btn-primary {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: var(--primary);
  color: var(--td-text-color-anti, #fff);
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.age-btn-secondary {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: transparent;
  color: var(--text);
  opacity: 0.6;
  font-size: 28rpx;
}
