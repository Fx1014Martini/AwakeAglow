{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": true,
    "noEmit": true,
    "types": ["miniprogram-api-typings", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "services/*": ["services/*"],
      "lib/*": ["lib/*"],
      "components/*": ["components/*"],
      "styles/*": ["styles/*"]
    }
  },
  "include": [
    "app.ts",
    "app.json",
    "pages/**/*.ts",
    "pkgDetail/**/*.ts",
    "pkgCompare/**/*.ts",
    "pkgExplore/**/*.ts",
    "custom-tab-bar/**/*.ts",
    "components/**/*.ts",
    "services/**/*.ts",
    "lib/**/*.ts",
    "styles/**/*.ts",
    "tests/**/*.ts",
    "config/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
