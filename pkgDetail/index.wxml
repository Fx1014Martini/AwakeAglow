<!--
  详情页（文档 PAGE-SPEC §3）
  模块顺序对齐原型 templates.js:99：四 Tab → Hero（海报图 + 名称 + 收藏）→ Tab 内容
  导航：自定义品牌顶部栏（brand-header，二级页显示返回按钮）
  主题接线：根节点 data-mode 跟随全局 store.mode（对齐原型 device 主题），app.wxss 用 view[data-mode] 选择器切换双主题。
-->
<view class="page page-enter detail-page" data-mode="{{mode}}">
  <!-- 品牌顶部栏（二级页显示返回，对齐原型 app-header） -->
  <brand-header mode="{{mode}}" show-back="{{true}}" />
  <!-- 加载骨架 -->
  <view wx:if="{{loading}}" class="detail-skeleton">
    <view class="skeleton-block skeleton-hero"></view>
    <view class="skeleton-line"></view>
    <view class="skeleton-line skeleton-line-short"></view>
  </view>

  <!-- 空态 -->
  <view wx:elif="{{!item}}" class="detail-empty">
    <t-empty title="详情加载失败" desc="该饮品不存在或已下架，请返回重试" btnText="返回" bind:action="onBack" />
  </view>

  <!-- 详情主体 -->
  <block wx:elif="{{item}}">
    <!-- 四 Tab（对齐原型 templates.js:99：tabs → hero → content） -->
    <view class="detail-tabs">
      <t-tabs tabs="{{tabs}}" active="{{activeTab}}" bind:change="onTabChange" />
    </view>

    <!-- Hero：海报图 + 名称 + 收藏 -->
    <view class="detail-hero">
      <image class="detail-hero-img" src="{{item.posterUrl || item.imageUrl}}" mode="aspectFill" lazy-load="{{true}}" binderror="onImgError" data-path="item.posterUrl" />
      <view class="detail-hero-mask"></view>
      <view class="detail-hero-copy">
        <view class="detail-name">{{item.nameZh}}</view>
        <view class="detail-en">{{item.nameEn}}</view>
        <view class="detail-desc">{{item.description}}</view>
        <view class="tags">
          <text wx:for="{{item.tags}}" wx:key="*this" wx:if="{{index < 5}}" class="tag">{{item}}</text>
        </view>
      </view>
      <view
        class="detail-fav {{favorite ? 'fav-active' : ''}}"
        catchtap="onToggleFavorite"
        hover-class="is-tap"
        aria-role="button"
        aria-label="{{favorite ? '取消收藏' : '收藏'}}"
      >
        <app-icon name="heart" size="{{34}}" mode="{{favorite ? mode : 'muted'}}" />
      </view>
    </view>

    <!-- 概览：配方比例/雷达 双列 → 制作步骤 → 相似推荐（对齐原型 templates.js:108 overview） -->
    <view wx:if="{{activeTab === 'overview'}}" class="detail-content">
      <view class="detail-grid">
        <view class="info-card">
          <view class="info-card-title">配方比例</view>
          <view wx:for="{{ingredientsPreview}}" wx:key="nameZh" class="ingredient-row">
            <view class="ingredient-name">{{item.nameZh}}<text wx:if="{{item.nameEn}}" class="ingredient-en"> {{item.nameEn}}</text></view>
            <text class="ingredient-amount">{{item.amountText}}</text>
          </view>
          <view wx:if="{{!ingredientsPreview.length}}" class="ingredient-empty">暂无原料信息</view>
        </view>
        <view class="info-card">
          <view class="info-card-title">风味雷达</view>
          <view class="radar-wrap">
            <t-radar-chart metrics="{{item.radar}}" size="{{180}}" mode="{{mode}}" />
          </view>
        </view>
      </view>

      <view class="step-card">
        <view class="info-card-title">制作步骤</view>
        <view wx:for="{{item.steps}}" wx:key="*this" class="step-row">
          <view class="step-index">{{index + 1}}</view>
          <text class="step-text">{{item}}</text>
          <text class="step-arrow" aria-hidden="true">›</text>
        </view>
        <view wx:if="{{!item.steps.length}}" class="ingredient-empty">暂无步骤信息</view>
      </view>

      <view class="section-head overview-similar-head">
        <view>
          <view class="section-title">相似推荐</view>
          <text class="section-sub">继续探索同类风格</text>
        </view>
        <view class="overview-more" hover-class="is-tap" bindtap="onGoSimilarTab" aria-role="button" aria-label="查看更多相似推荐">查看更多 ›</view>
      </view>
      <scroll-view class="similar-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
        <view
          wx:for="{{item.similar}}"
          wx:key="id"
          class="similar-card"
          data-id="{{item.id}}"
          bindtap="onOpenSimilar"
          hover-class="is-tap"
        >
          <image class="similar-photo" src="{{item.imageUrl}}" mode="aspectFill" lazy-load="{{true}}" binderror="onImgError" data-path="item.similar[{{index}}].imageUrl" />
          <view class="similar-copy">
            <view class="similar-name">{{item.nameZh}}</view>
            <view class="similar-en">{{item.nameEn}}</view>
          </view>
        </view>
      </scroll-view>
      <view wx:if="{{!item.similar.length}}" class="ingredient-empty">暂无相似推荐</view>
    </view>

    <!-- 配方：单卡「配方与制作」原料表 + 步骤列表（对齐原型 templates.js:105 recipe） -->
    <view wx:if="{{activeTab === 'recipe'}}" class="detail-content">
      <view class="step-card">
        <view class="info-card-title">配方与制作</view>
        <view wx:for="{{item.ingredients}}" wx:key="nameZh" class="ingredient-row">
          <view class="ingredient-name">{{item.nameZh}}<text wx:if="{{item.nameEn}}" class="ingredient-en"> {{item.nameEn}}</text></view>
          <text class="ingredient-amount">{{item.amountText}}</text>
        </view>
        <view wx:if="{{!item.ingredients.length}}" class="ingredient-empty">暂无原料信息</view>
        <view class="recipe-spacer"></view>
        <view wx:for="{{item.steps}}" wx:key="*this" class="step-row">
          <view class="step-index">{{index + 1}}</view>
          <text class="step-text">{{item}}</text>
          <text class="step-arrow" aria-hidden="true">›</text>
        </view>
        <view wx:if="{{!item.steps.length}}" class="ingredient-empty">暂无步骤信息</view>
      </view>
    </view>

    <!-- 雷达：单产品（对齐原型 templates.js:106 radar，含 lead 文案） -->
    <view wx:if="{{activeTab === 'radar'}}" class="detail-content">
      <view class="info-card">
        <view class="info-card-title">风味雷达</view>
        <view class="radar-wrap">
          <t-radar-chart metrics="{{item.radar}}" size="{{220}}" mode="{{mode}}" />
        </view>
        <text class="radar-tip">分数表达风格强弱，不代表品质高低。正式服务可直接替换 radar 数组。</text>
      </view>
    </view>

    <!-- 相似：横滑推荐卡片 -->
    <view wx:if="{{activeTab === 'similar'}}" class="detail-content">
      <view class="section-head">
        <view>
          <view class="section-title">相似推荐</view>
          <text class="section-sub">共享风味，但保留关键差异</text>
        </view>
      </view>
      <scroll-view class="similar-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
        <view
          wx:for="{{item.similar}}"
          wx:key="id"
          class="similar-card"
          data-id="{{item.id}}"
          bindtap="onOpenSimilar"
          hover-class="is-tap"
        >
          <image class="similar-photo" src="{{item.imageUrl}}" mode="aspectFill" lazy-load="{{true}}" binderror="onImgError" data-path="item.similar[{{index}}].imageUrl" />
          <view class="similar-copy">
            <view class="similar-name">{{item.nameZh}}</view>
            <view class="similar-en">{{item.nameEn}}</view>
          </view>
        </view>
      </scroll-view>
      <view wx:if="{{!item.similar.length}}" class="ingredient-empty">暂无相似推荐</view>
    </view>
  </block>

  <view class="toast-wrap">
    <app-toast content="{{toastText}}" show="{{toastShow}}" bind:hide="onToastHide" />
  </view>

  <!-- 底部导航（对齐原型：详情仍展示，高亮菜单） -->
  <custom-tab-bar selected="{{1}}" mode="{{mode}}" />
</view>
