{
  "name": "awakeaglow-v6-miniprogram-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "醒醺 V6 微信小程序（TypeScript + UnoCSS + TDesign 变量自建组件 + PAG）",
  "scripts": {
    "build": "npm run uno && tsc --noEmit && echo 'build ok'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "uno": "unocss \"src/uno-usage.{ts,js}\" -o dist/uno.wxss",
    "dev": "npm run uno && vitest watch"
  },
  "dependencies": {
    "@unocss/vite": "^0.65.4",
    "typescript": "^5.6.3",
    "unocss": "^0.65.4",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "devDependencies": {
    "@unocss/preset-uno": "^0.65.4",
    "miniprogram-simulate": "^1.6.2"
  }
}