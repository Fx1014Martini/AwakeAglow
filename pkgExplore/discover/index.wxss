.explore-page { padding: 0 var(--xx-page-gutter) 48rpx; }
.explore-intro { padding: 24rpx 0 32rpx; }
.eyebrow { display: block; color: var(--xx-primary); font-size: 17rpx; letter-spacing: .18em; font-weight: 800; margin-bottom: 12rpx; }
.explore-title { font-family: var(--xx-font-serif); font-size: 48rpx; font-weight: 500; line-height: 1.2; color: var(--xx-text); }
.explore-lead { display: block; margin-top: 12rpx; color: var(--xx-text2); font-size: 23rpx; }
.scene-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.scene-card { padding: 28rpx 24rpx; border-radius: var(--xx-radius-lg); border: 1rpx solid var(--xx-border); background: var(--xx-surface); box-shadow: var(--xx-card-shadow); transition: transform var(--xx-motion-fast) var(--xx-ease); }
.scene-card:active { transform: scale(.97); }
.scene-card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.scene-tag { font-size: 17rpx; font-weight: 700; color: var(--xx-text2); padding: 4rpx 12rpx; border-radius: var(--xx-radius-pill); background: var(--xx-surface-muted); }
.scene-name { font-family: var(--xx-font-serif); font-size: 33rpx; font-weight: 500; color: var(--xx-text); line-height: 1.3; }
.scene-desc { display: block; margin-top: 8rpx; font-size: 19rpx; color: var(--xx-text2); line-height: 1.5; }
