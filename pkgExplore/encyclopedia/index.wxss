.encyclopedia-page { padding: 0 var(--xx-page-gutter) 48rpx; }
.encyclopedia-intro { padding: 24rpx 0 32rpx; }
.eyebrow { display: block; color: var(--xx-primary); font-size: 17rpx; letter-spacing: .18em; font-weight: 800; margin-bottom: 12rpx; }
.encyclopedia-title { font-family: var(--xx-font-serif); font-size: 48rpx; font-weight: 500; color: var(--xx-text); }
.category-list { display: grid; gap: 16rpx; }
.category-card { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 24rpx; border-radius: var(--xx-radius-lg); border: 1rpx solid var(--xx-border); background: var(--xx-surface); box-shadow: var(--xx-card-shadow); transition: transform var(--xx-motion-fast) var(--xx-ease); }
.category-card:active { transform: scale(.98); }
.category-title { font-family: var(--xx-font-serif); font-size: 33rpx; font-weight: 500; color: var(--xx-text); }
.category-desc { display: block; margin-top: 6rpx; font-size: 21rpx; color: var(--xx-text2); }
.category-arrow { font-size: 36rpx; color: var(--xx-text2); }
.article-panel { margin-top: 24rpx; padding: 28rpx 24rpx; border-radius: var(--xx-radius-lg); background: var(--xx-text); color: var(--xx-surface); box-shadow: var(--xx-card-shadow); animation: article-in var(--xx-motion-normal) var(--xx-ease); }
.article-head { display: flex; justify-content: space-between; gap: 24rpx; align-items: flex-start; }
.article-title { font-family: var(--xx-font-serif); font-size: 38rpx; }
.article-lead { display: block; margin-top: 8rpx; color: rgba(255,255,255,.72); font-size: 22rpx; line-height: 1.5; }
.article-close { width: 44rpx; height: 44rpx; border-radius: 50%; text-align: center; line-height: 40rpx; font-size: 38rpx; color: rgba(255,255,255,.72); background: rgba(255,255,255,.1); }
.article-points { margin-top: 24rpx; display: grid; gap: 18rpx; }
.article-point { display: flex; gap: 18rpx; align-items: flex-start; color: rgba(255,255,255,.9); font-size: 24rpx; line-height: 1.55; }
.point-index { flex: 0 0 auto; color: var(--xx-accent); font-family: var(--xx-font-mono); font-size: 20rpx; }
@keyframes article-in { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: translateY(0); } }
