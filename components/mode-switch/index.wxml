<!-- 双模式切换：咖啡模式 / 微醺模式（对齐原型 modeSwitch，cup/wine SVG 图标）。点击触发 switch 事件 -->
<view class="mode-switch" role="tablist" aria-label="饮品模式">
  <view
    class="mode-option {{mode === 'coffee' ? 'mode-active' : ''}}"
    data-mode="coffee"
    bindtap="onSwitch"
    role="tab"
    aria-selected="{{mode === 'coffee'}}"
  >
    <svg class="mode-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 8h11v5a5 5 0 0 1-5 5H9a4 4 0 0 1-4-4V8Z"/><path d="M16 10h2a2.5 2.5 0 0 1 0 5h-2M7 4c0 1 1 1 1 2M11 4c0 1 1 1 1 2"/>
    </svg>
    <text>咖啡模式</text>
  </view>
  <view
    class="mode-option {{mode === 'cocktail' ? 'mode-active' : ''}}"
    data-mode="cocktail"
    bindtap="onSwitch"
    role="tab"
    aria-selected="{{mode === 'cocktail'}}"
  >
    <svg class="mode-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M7 3h10l-1 7a4 4 0 0 1-8 0L7 3Z"/><path d="M12 14v6M8 21h8"/>
    </svg>
    <text>微醺模式</text>
  </view>
</view>
