@import "../../styles/tokens.wxss";
@import "../../styles/td-variables.wxss";

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 44rpx;
  border: 0;
  border-radius: var(--td-radius-round);
  font-family: var(--td-font-family);
  font-size: var(--td-font-size-body-large);
  font-weight: 700;
  line-height: 1.2;
  color: var(--td-text-color-primary);
  background: var(--td-bg-color-container);
  transition: transform var(--motion-fast) var(--ease-standard), opacity var(--motion-fast) var(--ease-standard);
}

/* 移除微信原生 button 默认描边（::after） */
.btn::after {
  border: none;
}

.btn-primary {
  color: var(--td-text-color-anti);
  background: var(--td-brand-color-gradient);
  box-shadow: var(--td-shadow-1);
}

.btn-secondary {
  color: var(--td-text-color-primary);
  background: var(--td-bg-color-container);
  border: 1px solid var(--td-border-color);
}

.btn-block {
  display: flex;
  width: 100%;
}

.btn-disabled {
  opacity: .45;
}

.btn-loading {
  pointer-events: none;
}

.btn-hover {
  transform: scale(.97);
  opacity: .9;
}

.btn-spinner {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border: 3rpx solid currentColor;
  border-top-color: transparent;
  border-radius: 50%;
  opacity: .8;
  animation: btn-spin .8s linear infinite;
}

@keyframes btn-spin {
  to {
    transform: rotate(360deg);
  }
}
