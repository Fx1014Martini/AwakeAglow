/**
 * global.wxss - 全局 reset + 基础排版 + 公共工具类。
 * 组件优先复用此处定义的公共类，减少页面 WXSS 重复。
 */

page {
  min-height: 100%;
  font-family: var(--xx-font-sans);
  font-size: 28rpx;
  line-height: 1.5;
  background: var(--xx-bg, #f8f2e9);
  color: var(--xx-text, #342216);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  overflow-x: hidden;
}

view, text, image, button, input, textarea, scroll-view, canvas, cover-view {
  box-sizing: border-box;
}

button, input, textarea { font: inherit; }
button { margin: 0; padding: 0; line-height: normal; border-radius: 0; background: transparent; color: inherit; border: 0; cursor: pointer; }
button::after { border: 0; }
button, input, textarea { -webkit-tap-highlight-color: transparent; }
image { display: block; max-width: 100%; }
[hidden], .is-hidden { display: none !important; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

/* ---------- 页面布局 ---------- */
.page-shell { min-height: 100vh; padding-bottom: calc(130rpx + env(safe-area-inset-bottom)); transition: background var(--xx-motion-slow) var(--xx-ease), color var(--xx-motion-normal) var(--xx-ease); }
.page-content { padding: 0 var(--xx-page-gutter) 48rpx; }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
.page-enter { animation: xx-fade-up var(--xx-motion-normal) var(--xx-ease) both; }

/* ---------- 字体工具类 ---------- */
.serif { font-family: var(--xx-font-serif); }
.latin { font-family: var(--xx-font-latin); }
.number { font-family: var(--xx-font-number); font-variant-numeric: tabular-nums; }

/* ---------- 区块标题（对齐原型 section-head：22px/0/11px margin + h2 21px + p 10px + button 11px） ---------- */
.section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 12rpx; margin: 42rpx 0 21rpx; }
.section-head__title { font-family: var(--xx-font-serif); font-size: 40rpx; line-height: 1.14; font-weight: 500; letter-spacing: -.02em; color: var(--xx-text); }
.section-head__sub { display: block; margin-top: 8rpx; font-size: 19rpx; color: var(--xx-text2); }
.section-head__action { min-height: 58rpx; padding: 0 4rpx 0 16rpx; font-size: 21rpx; color: var(--xx-primary); }

/* ---------- 卡片 ---------- */
.surface-card { background: var(--xx-surface); border: 1rpx solid var(--xx-border); border-radius: var(--xx-radius-lg); box-shadow: var(--xx-card-shadow); }

/* ---------- 按钮（对齐原型 app.css §Shared：min-height 46px / padding 0 20px / font 12px / weight 800） ---------- */
.primary-button {
  min-height: 88rpx;
  border-radius: var(--xx-radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 0 38rpx;
  background: linear-gradient(120deg, var(--xx-primary), var(--xx-primary2));
  color: var(--xx-on-primary);
  font-size: 23rpx;
  font-weight: 800;
  box-shadow: var(--xx-shadow-soft);
  transition: transform var(--xx-motion-fast) var(--xx-ease), opacity var(--xx-motion-fast);
}
.theme-cocktail .primary-button,
view[data-mode="cocktail"] .primary-button {
  color: #24150b;
  background: linear-gradient(110deg, #d6aa5c, #f0cb82);
}
.primary-button:active { transform: scale(.975); opacity: .9; }

.secondary-button {
  min-height: 88rpx;
  padding: 0 38rpx;
  border-radius: var(--xx-radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--xx-border);
  background: var(--xx-surface-muted);
  color: var(--xx-text);
  font-size: 23rpx;
  font-weight: 800;
  transition: transform var(--xx-motion-fast) var(--xx-ease);
}
.secondary-button:active { transform: scale(.975); }

.icon-button {
  width: 73rpx;
  height: 73rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--xx-border);
  background: var(--xx-surface-strong);
  color: var(--xx-text);
  box-shadow: var(--xx-shadow-soft);
  transition: transform var(--xx-motion-fast) var(--xx-ease);
}
.icon-button:active { transform: scale(.95); }

/* ---------- 标签 ---------- */
.tags { display: flex; flex-wrap: wrap; gap: 10rpx; }
.tag {
  padding: 10rpx 15rpx;
  border-radius: 15rpx;
  display: inline-flex;
  align-items: center;
  font-size: 17rpx;
  color: var(--xx-text2);
  border: 1rpx solid var(--xx-border);
  background: var(--xx-surface-muted);
}

/* ---------- 空态 ---------- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  min-height: 346rpx;
  padding: 64rpx 40rpx;
  border: 1rpx dashed var(--xx-border);
  border-radius: var(--xx-radius-lg);
  text-align: center;
}
.empty-title { font-size: 30rpx; font-weight: 600; color: var(--xx-text); }
.empty-desc { font-size: 22rpx; color: var(--xx-text2); }

/* ---------- 骨架屏 ---------- */
.skeleton {
  background: linear-gradient(90deg, var(--xx-surface-muted), var(--xx-surface-strong), var(--xx-surface-muted));
  background-size: 200% 100%;
  animation: xx-shimmer 1.5s infinite;
}
@keyframes xx-shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

/* ---------- 动画 ---------- */
@keyframes xx-fade-up { from { opacity: 0; transform: translateY(18rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes xx-soft-glow { 0%, 100% { opacity: .7; transform: scale(.98); } 50% { opacity: 1; transform: scale(1.02); } }
.tap-scale:active { transform: scale(.975); }

/* ---------- 无障碍降级 ---------- */
@media (prefers-reduced-motion: reduce) {
  view, text, image, button, scroll-view, canvas {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}

/* ---------- 响应式断点（对齐原型 ADAPTIVE：≤360px Android Compact / ≤370px 窄屏 / 默认 / ≥430px 宽屏） ---------- */
@media (max-width: 360px) {
  page { --xx-page-gutter: 23rpx; }
}
@media (max-width: 370px) {
  page { --xx-page-gutter: 23rpx; }
}
@media (min-width: 430px) {
  page { --xx-page-gutter: 38rpx; }
}
